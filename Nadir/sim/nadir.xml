<mujoco model="nadir">
  <compiler angle="radian" meshdir="meshes/" />
  
  <option timestep="0.002" iterations="50" solver="Newton" tolerance="1e-10" />

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512" />
    <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2" width="512" height="512" mark="cross" markrgb=".8 .8 .8" />
    <material name="matplane" reflectance="0.3" texture="texplane" texrepeat="1 1" texuniform="true" />
    <material name="robot_mat" rgba="0.2 0.2 0.2 1" />
  </asset>

  <worldbody>
    <light directional="true" diffuse=".8 .8 .8" specular=".2 .2 .2" pos="0 0 5" dir="0 0 -1" />
    <geom name="floor" type="plane" size="0 0 1" material="matplane" condim="3" />
    
    <body name="torso" pos="0 0 0.35">
      <freejoint name="root" />
      <geom name="torso_geom" type="capsule" size="0.04 0.04" rgba="0.8 0.2 0.2 1" mass="0.5" />
      <site name="imu_site" pos="0 0 0" size="0.01" />
      <camera name="tracking_cam" pos="0 -1.5 0.5" xyaxes="1 0 0 0 1 2" mode="trackcom" />

      <!-- Right Leg -->
      <body name="hip_bracket_r" pos="0 -0.05 -0.04">
        <joint name="hip_pitch_r" type="hinge" axis="0 1 0" range="-1.2 1.2" />
        <geom type="box" size="0.02 0.02 0.02" mass="0.05" material="robot_mat" />
        
        <body name="upper_leg_r" pos="0 0 -0.02">
          <joint name="hip_roll_r" type="hinge" axis="1 0 0" range="-0.4 0.4" />
          <geom type="capsule" size="0.015 0.05" pos="0 0 -0.05" mass="0.15" material="robot_mat" />
          
          <body name="lower_leg_r" pos="0 0 -0.1">
            <joint name="knee_r" type="hinge" axis="0 1 0" range="-0.1 2.0" />
            <geom type="capsule" size="0.012 0.05" pos="0 0 -0.05" mass="0.12" material="robot_mat" />
            
            <body name="foot_r" pos="0 0 -0.1">
              <joint name="ankle_pitch_r" type="hinge" axis="0 1 0" range="-0.8 0.8" />
              <joint name="ankle_roll_r" type="hinge" axis="1 0 0" range="-0.3 0.3" />
              <geom type="box" size="0.025 0.015 0.005" pos="0 0 -0.005" mass="0.08" material="robot_mat" />
              <site name="foot_contact_r" pos="0 0 -0.01" size="0.01" type="sphere" rgba="0 1 0 0" />
            </body>
          </body>
        </body>
      </body>

      <!-- Left Leg -->
      <body name="hip_bracket_l" pos="0 0.05 -0.04">
        <joint name="hip_pitch_l" type="hinge" axis="0 1 0" range="-1.2 1.2" />
        <geom type="box" size="0.02 0.02 0.02" mass="0.05" material="robot_mat" />
        
        <body name="upper_leg_l" pos="0 0 -0.02">
          <joint name="hip_roll_l" type="hinge" axis="1 0 0" range="-0.4 0.4" />
          <geom type="capsule" size="0.015 0.05" pos="0 0 -0.05" mass="0.15" material="robot_mat" />
          
          <body name="lower_leg_l" pos="0 0 -0.1">
            <joint name="knee_l" type="hinge" axis="0 1 0" range="-0.1 2.0" />
            <geom type="capsule" size="0.012 0.05" pos="0 0 -0.05" mass="0.12" material="robot_mat" />
            
            <body name="foot_l" pos="0 0 -0.1">
              <joint name="ankle_pitch_l" type="hinge" axis="0 1 0" range="-0.8 0.8" />
              <joint name="ankle_roll_l" type="hinge" axis="1 0 0" range="-0.3 0.3" />
              <geom type="box" size="0.025 0.015 0.005" pos="0 0 -0.005" mass="0.08" material="robot_mat" />
              <site name="foot_contact_l" pos="0 0 -0.01" size="0.01" type="sphere" rgba="0 1 0 0" />
            </body>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <actuator>
    <position name="hip_pitch_r" joint="hip_pitch_r" ctrlrange="-1 1" forcerange="-3 3" kp="40" kv="2" />
    <position name="hip_roll_r" joint="hip_roll_r" ctrlrange="-1 1" forcerange="-3 3" kp="40" kv="2" />
    <position name="knee_r" joint="knee_r" ctrlrange="-1 1" forcerange="-3 3" kp="40" kv="2" />
    <position name="ankle_pitch_r" joint="ankle_pitch_r" ctrlrange="-1 1" forcerange="-3 3" kp="40" kv="2" />
    <position name="ankle_roll_r" joint="ankle_roll_r" ctrlrange="-1 1" forcerange="-3 3" kp="40" kv="2" />
    <position name="hip_pitch_l" joint="hip_pitch_l" ctrlrange="-1 1" forcerange="-3 3" kp="40" kv="2" />
    <position name="hip_roll_l" joint="hip_roll_l" ctrlrange="-1 1" forcerange="-3 3" kp="40" kv="2" />
    <position name="knee_l" joint="knee_l" ctrlrange="-1 1" forcerange="-3 3" kp="40" kv="2" />
    <position name="ankle_pitch_l" joint="ankle_pitch_l" ctrlrange="-1 1" forcerange="-3 3" kp="40" kv="2" />
    <position name="ankle_roll_l" joint="ankle_roll_l" ctrlrange="-1 1" forcerange="-3 3" kp="40" kv="2" />
  </actuator>

  <sensor>
    <accelerometer name="accel" site="imu_site" />
    <gyro name="gyro" site="imu_site" />
    <touch name="touch_foot_r" site="foot_contact_r" />
    <touch name="touch_foot_l" site="foot_contact_l" />
  </sensor>
</mujoco>
