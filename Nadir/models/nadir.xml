<mujoco model="nadir_bipedal_walker">
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.005" integrator="RK4"/>
  
  <default>
    <joint limited="true" damping="0.1" armature="0.01"/>
    <geom contype="1" conaffinity="1" friction="1.2 0.1 0.1" rgba="0.85 0.85 0.9 1"/>
    <motor ctrlrange="-1 1" ctrllimited="true"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" width="256" height="256" rgb1="0.15 0.18 0.25" rgb2="0.02 0.03 0.05"/>
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.2 0.25 0.3" rgb2="0.12 0.15 0.18" width="512" height="512"/>
    <material name="MatPlane" texture="texplane" texrepeat="50 50" texuniform="true" reflectance="0.1"/>
    
    <material name="TorsoMat" rgba="0.15 0.15 0.2 1" specular="0.4" shininess="0.5"/>
    <material name="RightLegMat" rgba="0.9 0.3 0.25 1" specular="0.3" shininess="0.4"/>
    <material name="LeftLegMat" rgba="0.2 0.7 0.85 1" specular="0.3" shininess="0.4"/>
    <material name="FootMat" rgba="0.1 0.1 0.12 1" specular="0.2"/>
  </asset>

  <worldbody>
    <light directional="true" diffuse="0.9 0.9 0.9" specular="0.3 0.3 0.3" pos="0 -2 5" dir="0 0.5 -1"/>
    <light directional="true" diffuse="0.4 0.4 0.5" specular="0.1 0.1 0.1" pos="0 2 3" dir="0 -0.5 -1"/>
    <geom name="floor" type="plane" pos="0 0 0" size="100 100 1" material="MatPlane"/>

    <!-- Torso / Base Body -->
    <body name="torso" pos="0 0 1.25">
      <camera name="track" mode="trackcom" pos="0 -3.2 0.4" xyaxes="1 0 0 0 0 1"/>
      <joint name="rootx" type="slide" axis="1 0 0" pos="0 0 0" limited="false" damping="0" armature="0"/>
      <joint name="rootz" type="slide" axis="0 0 1" pos="0 0 0" limited="false" damping="0" armature="0"/>
      <joint name="rooty" type="hinge" axis="0 1 0" pos="0 0 0" limited="false" damping="0" armature="0"/>
      
      <!-- Torso Geometry -->
      <geom name="torso_geom" type="capsule" fromto="0 0 -0.2 0 0 0.2" size="0.06" material="TorsoMat" mass="4.0"/>
      <geom name="head_geom" type="sphere" pos="0 0 0.28" size="0.08" rgba="0.95 0.95 0.98 1" mass="1.0"/>
      <site name="imu_site" pos="0 0 0"/>

      <!-- Right Leg (Color: Coral Red) -->
      <body name="thigh_right" pos="0 -0.09 -0.2">
        <joint name="thigh_joint_right" type="hinge" pos="0 0 0" axis="0 1 0" range="-150 0"/>
        <geom name="thigh_geom_right" type="capsule" fromto="0 0 0 0 0 -0.4" size="0.04" material="RightLegMat" mass="1.5"/>
        <body name="leg_right" pos="0 0 -0.4">
          <joint name="leg_joint_right" type="hinge" pos="0 0 0" axis="0 1 0" range="-150 0"/>
          <geom name="leg_geom_right" type="capsule" fromto="0 0 0 0 0 -0.4" size="0.03" material="RightLegMat" mass="1.2"/>
          <body name="foot_right" pos="0 0 -0.4">
            <joint name="foot_joint_right" type="hinge" pos="0 0 0" axis="0 1 0" range="-45 45"/>
            <geom name="foot_geom_right" type="box" pos="0.06 0 -0.02" size="0.11 0.045 0.02" material="FootMat" mass="0.5"/>
            <site name="touch_foot_right" pos="0.06 0 -0.04" size="0.04 0.03 0.01" type="box"/>
          </body>
        </body>
      </body>

      <!-- Left Leg (Color: Cyan Blue) -->
      <body name="thigh_left" pos="0 0.09 -0.2">
        <joint name="thigh_joint_left" type="hinge" pos="0 0 0" axis="0 1 0" range="-150 0"/>
        <geom name="thigh_geom_left" type="capsule" fromto="0 0 0 0 0 -0.4" size="0.04" material="LeftLegMat" mass="1.5"/>
        <body name="leg_left" pos="0 0 -0.4">
          <joint name="leg_joint_left" type="hinge" pos="0 0 0" axis="0 1 0" range="-150 0"/>
          <geom name="leg_geom_left" type="capsule" fromto="0 0 0 0 0 -0.4" size="0.03" material="LeftLegMat" mass="1.2"/>
          <body name="foot_left" pos="0 0 -0.4">
            <joint name="foot_joint_left" type="hinge" pos="0 0 0" axis="0 1 0" range="-45 45"/>
            <geom name="foot_geom_left" type="box" pos="0.06 0 -0.02" size="0.11 0.045 0.02" material="FootMat" mass="0.5"/>
            <site name="touch_foot_left" pos="0.06 0 -0.04" size="0.04 0.03 0.01" type="box"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="thigh_right_motor" joint="thigh_joint_right" gear="100"/>
    <motor name="leg_right_motor" joint="leg_joint_right" gear="100"/>
    <motor name="foot_right_motor" joint="foot_joint_right" gear="50"/>
    <motor name="thigh_left_motor" joint="thigh_joint_left" gear="100"/>
    <motor name="leg_left_motor" joint="leg_joint_left" gear="100"/>
    <motor name="foot_left_motor" joint="foot_joint_left" gear="50"/>
  </actuator>

  <sensor>
    <accelerometer name="imu_accel" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>
    <touch name="foot_right_contact" site="touch_foot_right"/>
    <touch name="foot_left_contact" site="touch_foot_left"/>
  </sensor>
</mujoco>
